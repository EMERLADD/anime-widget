<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name" />

    <!-- System-owned clock: continues to tick even when the app process is stopped. -->
    <TextClock
        android:id="@+id/widget_clock"
        android:layout_width="120dp"
        android:layout_height="45dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:includeFontPadding="false"
        android:shadowColor="#193C87"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="3"
        android:textColor="#FAFCFF"
        android:textSize="18sp" />

    <!-- Native Android control: independent of Pillow rendering and always clickable. -->
    <ImageView
        android:id="@+id/refresh_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="0dp"
        android:layout_marginStart="0dp"
        android:background="@drawable/refresh_button_background"
        android:padding="9dp"
        android:src="@drawable/refresh_icon"
        android:scaleType="fitCenter"
        android:contentDescription="@string/refresh_weather" />

    <!-- Transparent native hit target aligned with the Pillow-rendered AI input pill. -->
    <TextView
        android:id="@+id/ai_input_touch"
        android:layout_width="108dp"
        android:layout_height="18dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:contentDescription="点击以询问天气意见" />

</FrameLayout>
